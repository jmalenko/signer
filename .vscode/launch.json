{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Signer: Launch",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Signer: Launch with examples",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "-document",
        "${workspaceFolder}/examples/document.pdf",
        "-signature",
        "${workspaceFolder}/examples/signature.png"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Signer: Build signer.exe (PyInstaller)",
      "type": "debugpy",
      "request": "launch",
      "module": "PyInstaller",
      "args": [
        "--noconfirm",
        "--log-level",
        "INFO",
        "--onefile",
        "--windowed",
        "--name",
        "signer",
        "main.py"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
